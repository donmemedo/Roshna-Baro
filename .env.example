# Copy to .env and fill in. `docker compose` refuses to start without SECRET_KEY.
# Generate: openssl rand -base64 48
SECRET_KEY=

# Origins the browser may call the API from (comma separated, no wildcard allowed)
CORS_ORIGINS=http://localhost:3036,http://127.0.0.1:3036

# Public URL of the API as the BROWSER sees it (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8036

# Off by default. Turns on the public demo account (demo@glow.ir) and the demo button.
DEMO_MODE=false

# Expose /docs and /openapi.json (leave off in production)
ENABLE_DOCS=false

# Behind a reverse proxy: the proxy's IP, so per-client rate limits work (uvicorn trusts X-Forwarded-For only from here)
FORWARDED_ALLOW_IPS=127.0.0.1

# Set to 1 once the site is served over HTTPS
CSP_UPGRADE_INSECURE=0

# Bind ports to this address. 127.0.0.1 = local only; use 0.0.0.0 only behind a firewall/proxy.
BIND_ADDRESS=127.0.0.1

# Local development without Docker (backend/): APP_ENV=dev lets the API start with a random per-process key.
# APP_ENV=dev
